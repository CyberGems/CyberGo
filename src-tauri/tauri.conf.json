{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberGo",
  "version": "0.1.0",
  "identifier": "me.cybergems.cybergo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CyberGo",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 550,
        "decorations": false,
        "transparent": false,
        "visible": true,
        "center": true
      },
      {
        "label": "reminders",
        "title": "Reminders",
        "width": 620,
        "height": 420,
        "minWidth": 520,
        "minHeight": 360,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": { "opener": {}, "log": { "level": "info" } }
}
