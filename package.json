{
  "name": "cybergo",
  "private": true,
  "version": "0.1.0-alpha.5",
  "author": "CyberGems",
  "license": "GPL-3.0-only",
  "description": "Local event and task reminders for Windows",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "release:pre": "npm run lint && npm test && npm run build && node scripts/build-release.mjs",
    "lint": "tsc --noEmit",
    "test": "tsx --test shared/schedule.test.ts shared/csv.test.ts shared/quick.test.ts shared/auth.test.ts shared/ics.test.ts src/lib/stats.test.ts src/lib/format.test.ts src/lib/view.test.ts src/components/ModalKeys.test.ts electron/db.test.ts electron/validate.test.ts electron/window-bounds.test.ts",
    "assets": "node scripts/gen-assets.mjs"
  },
  "build": {
    "appId": "com.cybergo.app",
    "productName": "CyberGo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-setup.${ext}",
      "shortcutName": "${productName}",
      "uninstallDisplayName": "${productName} ${version}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "en",
        "es"
      ],
      "multiLanguageInstaller": true
    },
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
