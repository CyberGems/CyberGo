{
  "name": "cybergo",
  "private": true,
  "version": "0.1.0",
  "author": "CyberGems",
  "description": "Local event and task reminders for Windows",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:electron": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "tsx --test shared/schedule.test.ts shared/csv.test.ts shared/quick.test.ts shared/auth.test.ts shared/placement.test.ts",
    "assets": "node scripts/gen-assets.mjs"
  },
  "build": {
    "appId": "com.cybergo.app",
    "productName": "CyberGo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": ["nsis"]
    },
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7"
  }
}
